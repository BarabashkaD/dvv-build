# FFmpeg of the third-party prefix: custom_ffmpeg @ffmpeg_VERSION@, an LGPL shared build (spec §2,
# §13.2; M4 design D3, §9). Written by the rawreel-workspace superbuild from
# deps/dvv_ffmpeg_sdkConfig.cmake.in; do not edit. FFmpeg is never linked: dvv-components compiles
# against these headers and loads the libraries at run time; ffmpeg serves the tests.
#
# Sets DVV_FFMPEG_RUNTIME_DIR (the folder of the six libraries the loader opens), DVV_FFMPEG_PROGRAM
# (the ffmpeg program) and the target dvv::ffmpeg_headers (INTERFACE IMPORTED: the include
# directory, which consumers see as a system directory). Not found unless that folder holds exactly
# one loadable file of each of avutil, avcodec, avformat, avfilter, swscale and swresample. The
# release data (version, URL and SHA256 of custom_ffmpeg and LAME) and DVV_BUNDLE_FFMPEG are in
# <prefix>/dvv-third-party-state.cmake.

# The archive's top folder: the one with include/libavutil/avutil.h (M4 Task 0 recorded the layout:
# <prefix>/custom_ffmpeg/<os>-<arch>/shared/lgpl: windows-x64, linux-x64, macos-arm64).
cmake_path(SET _dvv_ffmpeg_extracted NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/../../../custom_ffmpeg")
file(GLOB_RECURSE _dvv_ffmpeg_headers LIST_DIRECTORIES false "${_dvv_ffmpeg_extracted}/avutil.h")
list(FILTER _dvv_ffmpeg_headers INCLUDE REGEX "/include/libavutil/avutil\\.h$")
list(LENGTH _dvv_ffmpeg_headers _dvv_ffmpeg_count)
if(NOT _dvv_ffmpeg_count EQUAL 1)
    set(dvv_ffmpeg_sdk_FOUND FALSE)
    set(dvv_ffmpeg_sdk_NOT_FOUND_MESSAGE
        "expected one include/libavutil/avutil.h in ${_dvv_ffmpeg_extracted}, found "
        "${_dvv_ffmpeg_count}; run bootstrap")
    return()
endif()
string(REGEX REPLACE "/include/libavutil/avutil\\.h$" "" _dvv_ffmpeg_root "${_dvv_ffmpeg_headers}")
set(_dvv_ffmpeg_include_dir "${_dvv_ffmpeg_root}/include")
if(WIN32)
    set(DVV_FFMPEG_RUNTIME_DIR "${_dvv_ffmpeg_root}/bin")
else()
    set(DVV_FFMPEG_RUNTIME_DIR "${_dvv_ffmpeg_root}/lib")
endif()
set(DVV_FFMPEG_PROGRAM "${_dvv_ffmpeg_root}/bin/ffmpeg${CMAKE_EXECUTABLE_SUFFIX}")

# The six libraries of M4 design D3 (no avdevice, no postproc): exactly one loadable file of each.
foreach(_dvv_library IN ITEMS avutil avcodec avformat avfilter swscale swresample)
    if(WIN32)
        file(GLOB _dvv_loaded LIST_DIRECTORIES false "${DVV_FFMPEG_RUNTIME_DIR}/${_dvv_library}-*.dll")
    elseif(APPLE)
        # The loaded file is lib<name>.<major>.dylib, a link to lib<name>.<major>.<minor>.<micro>.dylib.
        file(GLOB _dvv_loaded LIST_DIRECTORIES false
             "${DVV_FFMPEG_RUNTIME_DIR}/lib${_dvv_library}.[0-9]*.dylib")
        list(FILTER _dvv_loaded INCLUDE REGEX "/lib${_dvv_library}\\.[0-9]+\\.dylib$")
    else()
        file(GLOB _dvv_loaded LIST_DIRECTORIES false "${DVV_FFMPEG_RUNTIME_DIR}/lib${_dvv_library}.so*")
        list(FILTER _dvv_loaded INCLUDE REGEX "/lib${_dvv_library}\\.so\\.[0-9]+$")
    endif()
    list(LENGTH _dvv_loaded _dvv_count)
    if(NOT _dvv_count EQUAL 1)
        set(dvv_ffmpeg_sdk_FOUND FALSE)
        set(dvv_ffmpeg_sdk_NOT_FOUND_MESSAGE
            "expected one ${_dvv_library} library in ${DVV_FFMPEG_RUNTIME_DIR}, found ${_dvv_count}")
        return()
    endif()
endforeach()
if(NOT EXISTS "${DVV_FFMPEG_PROGRAM}")
    set(dvv_ffmpeg_sdk_FOUND FALSE)
    set(dvv_ffmpeg_sdk_NOT_FOUND_MESSAGE "${DVV_FFMPEG_PROGRAM} does not exist; run bootstrap")
    return()
endif()

if(NOT TARGET dvv::ffmpeg_headers)
    add_library(dvv::ffmpeg_headers INTERFACE IMPORTED)
    set_target_properties(dvv::ffmpeg_headers PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_dvv_ffmpeg_include_dir}")
endif()
