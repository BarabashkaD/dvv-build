# Unit tests for cmake/DvvSpdx.cmake. Run: cmake -P tests/spdx/test_spdx.cmake
cmake_minimum_required(VERSION 4.2)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/DvvSpdx.cmake")

set(failures 0)
macro(expect expression linkage expected)
    dvv_spdx_evaluate("${expression}" "${linkage}" allowed reason)
    if(NOT allowed EQUAL ${expected})
        message(SEND_ERROR "FAIL: '${expression}' (${linkage}) gave ${allowed}, expected ${expected}; ${reason}")
        math(EXPR failures "${failures} + 1")
    endif()
endmacro()

expect("MIT" static 1)
expect("BSD-2-Clause-Patent" static 1)
expect("MIT OR GPL-2.0-only" static 1)
expect("MIT AND GPL-2.0-only" static 0)
expect("GPL-3.0-or-later" static 0)
expect("AGPL-3.0-only" runtime 0)
expect("LGPL-2.1-or-later" static 0)
expect("LGPL-2.1-or-later" runtime 1)
expect("LGPL-2.0-or-later WITH WxWindows-exception-3.1" static 1)
expect("GPL-3.0-or-later WITH Bison-exception-2.2" static 1)
expect("Apache-2.0 WITH LLVM-exception" static 1)
expect("GPL-2.0-or-later WITH Classpath-exception-2.0" static 0)
expect("AGPL-3.0-only WITH LLVM-exception" static 0)
expect("GPL-2.0-only WITH WxWindows-exception-3.1" static 0)
expect("GPL-2.0-only WITH Bison-exception-2.2" static 0)
expect("LGPL-2.1-or-later" tool 1)
expect("GPL-3.0-only" tool 0)
expect("(MIT OR Apache-2.0) AND BSD-3-Clause" static 1)
expect("MIT OR Apache-2.0 AND GPL-2.0-only" static 1)
expect("(MIT OR Apache-2.0) AND GPL-2.0-only" static 0)
expect("(MIT" static 0)
expect("MIT)" static 0)
expect("MIT AND" static 0)
expect("MIT WITH" static 0)
expect("MIT BSD-3-Clause" static 0)
expect("" static 0)
expect("MIT" shipped 0)

# Tool-only licences.
expect("NCSA" tool 1)
expect("NCSA" runtime 0)
expect("NCSA" static 0)
expect("CC-BY-4.0" tool 1)
expect("CC-BY-4.0" runtime 0)
expect("CC-BY-4.0" static 0)
expect("MIT AND NCSA" runtime 0)
expect("MIT OR NCSA" static 1)
set(slang_spdx "Apache-2.0 WITH LLVM-exception AND Apache-2.0 AND MIT AND BSD-2-Clause AND \
BSD-3-Clause AND BSL-1.0 AND Unlicense AND GPL-3.0-or-later WITH Bison-exception-2.2 AND NCSA AND \
CC-BY-4.0")
expect("${slang_spdx}" tool 1)
expect("${slang_spdx}" runtime 0)
expect("${slang_spdx}" static 0)

# wxWidgets (M1b): libpng (version 2 licence; user decision D4); the JPEG-derived quantizer (IJG)
# and the XPM decoder (X11) bundled in wxcore (user decision U1).
expect("libpng-2.0" static 1)
expect("IJG" static 1)
expect("X11" static 1)
set(wx_windows_spdx "LGPL-2.0-or-later WITH WxWindows-exception-3.1 AND IJG AND X11 AND \
Unicode-DFS-2016 AND Zlib AND libpng-2.0")
set(wx_linux_spdx "LGPL-2.0-or-later WITH WxWindows-exception-3.1 AND IJG AND X11 AND \
Unicode-DFS-2016 AND Zlib")
expect("${wx_windows_spdx}" static 1)
expect("${wx_linux_spdx}" static 1)
expect("LGPL-2.0-or-later AND Zlib" static 0)

# custom_ffmpeg (M4): LAME (LGPL-2.0-or-later) and SVT-AV1 (BSD-3-Clause-Clear) are allowed only for
# run-time-loaded libraries (only custom_ffmpeg's shared libraries carry these licences).
expect("LGPL-2.0-or-later" runtime 1)
expect("LGPL-2.0-or-later" tool 1)
expect("LGPL-2.0-or-later" static 0)
expect("LGPL-2.0-only" runtime 0)
expect("BSD-3-Clause-Clear" runtime 1)
expect("BSD-3-Clause-Clear" tool 1)
expect("BSD-3-Clause-Clear" static 0)
expect("LGPL-2.0-or-later WITH WxWindows-exception-3.1" static 1)
set(ffmpeg_spdx "LGPL-2.1-or-later AND LGPL-2.0-or-later AND BSD-3-Clause AND BSD-2-Clause AND \
BSD-3-Clause-Clear AND MIT AND Zlib")
expect("${ffmpeg_spdx}" runtime 1)
expect("${ffmpeg_spdx}" static 0)

dvv_spdx_evaluate("MIT AND GPL-2.0-only" static allowed reason)
if(NOT reason MATCHES "GPL-2.0-only")
    message(SEND_ERROR "FAIL: reason does not name the rejected licence: '${reason}'")
    math(EXPR failures "${failures} + 1")
endif()

if(failures GREATER 0)
    message(FATAL_ERROR "${failures} SPDX test(s) failed")
endif()
message(STATUS "SPDX tests passed")
