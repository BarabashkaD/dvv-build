# Tests dvv_os_sources() of cmake/DvvOsSources.cmake against fixture projects built in WORK_DIR.
# Each case writes <WORK_DIR>/<name>/ with empty per-OS files, configures it for the host and checks
# the exit status and the flattened output (spec 4.5 plus the sub-directory case of Review Focus 4).
#   cmake -DWORK_DIR=<dir> -DGENERATOR=<generator> [-DPLATFORM=<platform>] [-DMAKE_PROGRAM=<path>]
#         [-DCXX=<compiler>] -P test_os_sources.cmake
cmake_minimum_required(VERSION 4.2)

foreach(var IN ITEMS WORK_DIR GENERATOR)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
        message(FATAL_ERROR "test_os_sources: -D${var}=... is required")
    endif()
endforeach()
file(TO_CMAKE_PATH "${WORK_DIR}" WORK_DIR)
set(MODULE "${CMAKE_CURRENT_LIST_DIR}/../../cmake/DvvOsSources.cmake")
cmake_path(NORMAL_PATH MODULE)

if(CMAKE_HOST_WIN32)
    set(host WIN32)
elseif(CMAKE_HOST_APPLE)
    set(host APPLE)
else()
    set(host OTHER)
endif()

set(failures FALSE)
file(REMOVE_RECURSE "${WORK_DIR}")

# Configures <dir> with the test's generator settings; sets rc and flat (flattened output) in the caller.
function(configure dir)
    set(args -S "${dir}" -B "${dir}/build" -G "${GENERATOR}")
    if(PLATFORM)
        list(APPEND args -A "${PLATFORM}")
    endif()
    if(MAKE_PROGRAM)
        list(APPEND args "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
    endif()
    if(CXX)
        list(APPEND args "-DCMAKE_CXX_COMPILER=${CXX}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" ${args}
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
    string(REGEX REPLACE "[ \t\r\n]+" " " flattened "${out}")
    set(rc "${result}" PARENT_SCOPE)
    set(flat "${flattened}" PARENT_SCOPE)
    set(raw "${out}" PARENT_SCOPE)
endfunction()

# case(NAME <name> CALL <args> [FAILS] EXPECT <regex>... [ENABLE_OBJCXX] [FULL_PATHS] [IN_SUBDIR]
#      FILES <rel>...)
function(case)
    cmake_parse_arguments(PARSE_ARGV 0 C "FAILS;ENABLE_OBJCXX;FULL_PATHS;IN_SUBDIR" "NAME" "CALL;EXPECT;FILES")
    set(dir "${WORK_DIR}/${C_NAME}")
    foreach(rel IN LISTS C_FILES)
        file(WRITE "${dir}/${rel}" "")
    endforeach()
    file(WRITE "${dir}/main.cpp" "")

    set(enable "")
    if(C_ENABLE_OBJCXX)
        set(enable "enable_language(OBJCXX)\n")
    endif()
    set(call "dvv_os_sources(fx ${C_CALL})\n")
    set(top "cmake_minimum_required(VERSION 4.2)\nproject(fx LANGUAGES CXX)\n${enable}include(\"${MODULE}\")\nadd_library(fx STATIC main.cpp)\n")
    if(C_IN_SUBDIR)
        file(WRITE "${dir}/sub/CMakeLists.txt" "${call}")
        string(APPEND top "add_subdirectory(sub)\n")
    else()
        string(APPEND top "${call}")
    endif()
    # Last in the top CMakeLists.txt: report the sources (as file names unless FULL_PATHS) and, for each
    # .mm source, its COMPILE_OPTIONS read from the target's own directory.
    string(APPEND top "get_target_property(_all fx SOURCES)\nset(_srcs \"\")\nforeach(s IN LISTS _all)\n")
    if(C_FULL_PATHS)
        string(APPEND top "    list(APPEND _srcs \"\${s}\")\n")
    else()
        string(APPEND top "    cmake_path(GET s FILENAME n)\n    list(APPEND _srcs \"\${n}\")\n")
    endif()
    string(APPEND top "endforeach()\nmessage(STATUS \"fx-sources=[\${_srcs}]\")\n")
    string(APPEND top "foreach(s IN LISTS _all)\n    if(s MATCHES \"\\\\.mm\$\")\n        cmake_path(GET s FILENAME n)\n        get_property(o SOURCE \"\${s}\" TARGET_DIRECTORY fx PROPERTY COMPILE_OPTIONS)\n        message(STATUS \"fx-mm=[\${n}:\${o}]\")\n    endif()\nendforeach()\n")
    file(WRITE "${dir}/CMakeLists.txt" "${top}")

    configure("${dir}")
    if(C_FAILS AND rc EQUAL 0)
        message(SEND_ERROR "${C_NAME}: expected a configure failure, it succeeded:\n${raw}")
        set(failures TRUE PARENT_SCOPE)
    elseif(NOT C_FAILS AND NOT rc EQUAL 0)
        message(SEND_ERROR "${C_NAME}: configure failed (${rc}):\n${raw}")
        set(failures TRUE PARENT_SCOPE)
    endif()
    foreach(regex IN LISTS C_EXPECT)
        if(NOT flat MATCHES "${regex}")
            message(SEND_ERROR "${C_NAME}: output does not match [${regex}]:\n${raw}")
            set(failures TRUE PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# layered, and dvv_os_suffixes read from a fixture
if(host STREQUAL "WIN32")
    set(layered "fx-sources=\\[main\\.cpp;x_win32\\.cpp\\]")
    set(layered_suffixes "suffixes=\\[win32;msw\\]")
elseif(host STREQUAL "APPLE")
    set(layered "fx-sources=\\[main\\.cpp;x_posix\\.cpp;x_macos\\.cpp\\]")
    set(layered_suffixes "suffixes=\\[posix;macos;metal;cocoa\\]")
else()
    set(layered "fx-sources=\\[main\\.cpp;x_posix\\.cpp;x_linux\\.cpp\\]")
    set(layered_suffixes "suffixes=\\[posix;linux;xlib;gtk\\]")
endif()
case(NAME layered CALL x EXPECT "${layered}"
     FILES x_win32.cpp x_posix.cpp x_macos.cpp x_linux.cpp)
file(WRITE "${WORK_DIR}/suffix_probe/CMakeLists.txt" "cmake_minimum_required(VERSION 4.2)\nproject(fx LANGUAGES NONE)\ninclude(\"${MODULE}\")\ndvv_os_suffixes(s)\nmessage(STATUS \"suffixes=[\${s}]\")\n")
configure("${WORK_DIR}/suffix_probe")
if(NOT rc EQUAL 0 OR NOT flat MATCHES "${layered_suffixes}")
    message(SEND_ERROR "layered: dvv_os_suffixes from a fixture did not give the host's list:\n${raw}")
    set(failures TRUE)
endif()

case(NAME stub_only CALL y EXPECT "fx-sources=\\[main\\.cpp;y_stub\\.cpp\\]" FILES y_stub.cpp)

if(host STREQUAL "WIN32")
    set(own "fx-sources=\\[main\\.cpp;z_win32\\.cpp\\]")
    set(opt "fx-sources=\\[main\\.cpp;o_win32\\.cpp\\]")
else()
    set(own "fx-sources=\\[main\\.cpp;z_stub\\.cpp\\]")
    set(opt "fx-sources=\\[main\\.cpp\\]")
endif()
case(NAME own_beats_stub CALL z EXPECT "${own}" FILES z_win32.cpp z_stub.cpp)
case(NAME no_file CALL none FAILS
     EXPECT "none: no file for (WIN32|APPLE|OTHER) and no none_stub\\.cpp")
case(NAME optional_other CALL OPTIONAL o EXPECT "${opt}" FILES o_win32.cpp)
case(NAME no_stem CALL "" FAILS EXPECT "dvv_os_sources: no stem given")
case(NAME no_stem_optional CALL OPTIONAL FAILS EXPECT "dvv_os_sources: no stem given")
case(NAME misspelt CALL OPTIONAL x_typo FAILS
     EXPECT "x_typo: matches no per-OS file on any platform" FILES x_posix.cpp)

if(host STREQUAL "APPLE")
    case(NAME both CALL x FAILS EXPECT "x_cocoa: both \\.cpp and \\.mm" FILES x_cocoa.cpp x_cocoa.mm)
    case(NAME arc CALL m ENABLE_OBJCXX EXPECT "fx-mm=\\[m_cocoa\\.mm:-fobjc-arc\\]" FILES m_cocoa.mm)
    case(NAME no_objcxx CALL m FAILS EXPECT "m_cocoa\\.mm: enable OBJCXX before dvv_os_sources"
         FILES m_cocoa.mm)
endif()

# A call from a sub-directory: the sources are absolute paths under sub/, and the ARC option set
# with TARGET_DIRECTORY is visible from the target's own directory.
set(abs "(/|[A-Za-z]:/)[^;]*/subdir/sub/")
set(sub_flags "")
if(host STREQUAL "WIN32")
    set(sub_expect "fx-sources=\\[main\\.cpp;${abs}s_win32\\.cpp\\]")
    set(sub_files sub/s_posix.cpp sub/s_win32.cpp)
elseif(host STREQUAL "APPLE")
    set(sub_expect "fx-sources=\\[main\\.cpp;${abs}s_posix\\.cpp;${abs}s_cocoa\\.mm\\]"
        "fx-mm=\\[s_cocoa\\.mm:-fobjc-arc\\]")
    set(sub_files sub/s_posix.cpp sub/s_win32.cpp sub/s_cocoa.mm)
    set(sub_flags ENABLE_OBJCXX)
else()
    set(sub_expect "fx-sources=\\[main\\.cpp;${abs}s_posix\\.cpp\\]")
    set(sub_files sub/s_posix.cpp sub/s_win32.cpp)
endif()
case(NAME subdir CALL s ${sub_flags} FULL_PATHS IN_SUBDIR EXPECT ${sub_expect} FILES ${sub_files})

if(failures)
    message(FATAL_ERROR "test_os_sources: failures")
endif()
message(STATUS "test_os_sources: all cases passed")
