# The in-job check of the prebuilt Linux CI image (spec section 5.6): the image was built from this
# dvv-build's inputs, the job runs as the owner of the workspace, the tools and packages are the
# pinned ones, and the Python environment is the interpreter's own. It reports every mismatch, one
# message each, then fails; on a pass it prints the report (user, locks, hashes, image reference).
#   cmake -DDVV_BUILD=<dvv-build root> [-DIMAGE_DIR=<dir>] [-DFACTS_DIR=<dir>] \
#         -P tools/check-ci-image.cmake
# IMAGE_DIR defaults to /etc/dvv-ci-image. Live mode reads $ENV{GITHUB_WORKSPACE}, runs the tools,
# and reads $ENV{DVV_CI_IMAGE} (the image reference, optional). With FACTS_DIR the facts come from
# saved files instead (tests/ci/test_check_ci_image.cmake): uid, gid, workspace-uid, cmake.txt,
# ninja.txt, clang-format.txt, clang-tidy.txt, pip-show/<name>.txt, python.txt, python-prefix.txt,
# env.txt, clang-19.txt, dpkg/<package>.txt and image/{inputs.sha256,environment.sha256,
# packages.lock,pip.lock}.
# Versions are compared as whole tokens. cmake: the first line is "cmake version <pin>". ninja: the
# first line is <pin> or "<pin>.git.<text>" (the wheel prints 1.13.2.git.kitware.jobserver-pipe-1).
# clang-format and clang-tidy: <pin> is not part of a longer dotted number. `pip show` decides what
# is installed: its line must be exactly "Version: <pin>".
cmake_minimum_required(VERSION 4.2)
if(NOT DVV_BUILD)
    set(DVV_BUILD "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
cmake_path(NORMAL_PATH DVV_BUILD OUTPUT_VARIABLE root)
if(NOT IMAGE_DIR)
    set(IMAGE_DIR /etc/dvv-ci-image)
endif()

# Live mode: nothing is gathered before this.
if(FACTS_DIR)
    set(image_dir "${FACTS_DIR}/image")
else()
    set(image_dir "${IMAGE_DIR}")
    if(NOT EXISTS "${IMAGE_DIR}/inputs.sha256")
        message(FATAL_ERROR
            "check-ci-image: ${IMAGE_DIR}/inputs.sha256 not found: this job does not run in the dvv CI image")
    endif()
endif()

# problem(<text>): one mismatch; the script fails at the end (SEND_ERROR) and goes on collecting.
function(problem text)
    message(SEND_ERROR "check-ci-image: ${text}")
    set_property(GLOBAL PROPERTY DVV_CHECK_FAILED TRUE)
endfunction()

# fact(<var> <name> [TOLERATE] COMMAND <command>...): the text of one fact, from FACTS_DIR or from the
# command. A live command that cannot run, or exits non-zero, is a problem and sets <var>_failed;
# TOLERATE accepts a non-zero exit of a command that did run (dpkg-query, pip show): the fact is then
# the text it printed, and the check reports it.
function(fact var name)
    cmake_parse_arguments(PARSE_ARGV 2 F "TOLERATE" "" "COMMAND")
    if(FACTS_DIR)
        if(NOT EXISTS "${FACTS_DIR}/${name}")
            message(FATAL_ERROR "check-ci-image: fact file ${FACTS_DIR}/${name} is missing")
        endif()
        file(READ "${FACTS_DIR}/${name}" text)
    else()
        execute_process(COMMAND ${F_COMMAND} RESULT_VARIABLE status OUTPUT_VARIABLE text
                        ERROR_VARIABLE err)
        if(NOT status STREQUAL "0" AND NOT (F_TOLERATE AND status MATCHES "^[0-9]+$"))
            string(STRIP "${err}" detail)
            if(detail STREQUAL "")
                set(detail "${status}")
            endif()
            list(JOIN F_COMMAND " " command)
            problem("could not run '${command}': ${detail}")
            set(${var}_failed TRUE PARENT_SCOPE)
            set(text "")
        endif()
    endif()
    set(${var} "${text}" PARENT_SCOPE)
endfunction()

function(first_line var text)
    string(REGEX MATCH "^[^\r\n]*" line "${text}")
    set(${var} "${line}" PARENT_SCOPE)
endfunction()

function(trimmed var text)
    string(STRIP "${text}" text)
    set(${var} "${text}" PARENT_SCOPE)
endfunction()

# The token after "version", else the first version-like token of the first line, else that line.
function(version_of var text)
    if(text MATCHES "version ([0-9][0-9A-Za-z.+_-]*)")
        set(token "${CMAKE_MATCH_1}")
    else()
        first_line(line "${text}")
        string(REGEX MATCH "[0-9][0-9A-Za-z.+_-]*" token "${line}")
        if(token STREQUAL "")
            set(token "${line}")
        endif()
    endif()
    set(${var} "${token}" PARENT_SCOPE)
endfunction()

set_property(GLOBAL PROPERTY DVV_CHECK_FAILED FALSE)

# ---- gather every fact ----
fact(uid_text uid COMMAND id -u)
fact(gid_text gid COMMAND id -g)
if(NOT FACTS_DIR AND "$ENV{GITHUB_WORKSPACE}" STREQUAL "")
    problem("GITHUB_WORKSPACE is not set; the owner of the workspace is unknown")
    set(owner_text "")
    set(owner_text_failed TRUE)
else()
    fact(owner_text workspace-uid COMMAND stat -c %u "$ENV{GITHUB_WORKSPACE}")
endif()
set(tools cmake ninja clang-format clang-tidy)
foreach(tool IN LISTS tools)
    fact(version_${tool} ${tool}.txt COMMAND ${tool} --version)
    fact(pip_${tool} pip-show/${tool}.txt TOLERATE COMMAND python -m pip show ${tool})
endforeach()
fact(python_text python.txt COMMAND python --version)
fact(prefix_text python-prefix.txt COMMAND python -c "import sys; print(sys.prefix)")
if(FACTS_DIR)
    fact(env_text env.txt)
else()
    set(env_text
        "Python3_ROOT_DIR=$ENV{Python3_ROOT_DIR}\npythonLocation=$ENV{pythonLocation}\nPKG_CONFIG_PATH=$ENV{PKG_CONFIG_PATH}\n")
endif()
fact(clang_text clang-19.txt COMMAND clang-19 --version)

set(packages "")
if(EXISTS "${root}/ci-image/packages.txt")
    file(STRINGS "${root}/ci-image/packages.txt" lines)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(NOT line STREQUAL "" AND NOT line MATCHES "^#")
            list(APPEND packages "${line}")
        endif()
    endforeach()
endif()
foreach(pkg IN LISTS packages)
    fact(dpkg_${pkg} dpkg/${pkg}.txt TOLERATE COMMAND dpkg-query -W -f=\${Status} ${pkg})
endforeach()

foreach(name inputs environment)
    if(NOT EXISTS "${image_dir}/${name}.sha256")
        message(FATAL_ERROR "check-ci-image: ${image_dir}/${name}.sha256 not found")
    endif()
    file(READ "${image_dir}/${name}.sha256" image_${name})
    string(STRIP "${image_${name}}" image_${name})
endforeach()
foreach(name packages pip)
    if(NOT EXISTS "${image_dir}/${name}.lock")
        message(FATAL_ERROR "check-ci-image: ${image_dir}/${name}.lock not found")
    endif()
    file(READ "${image_dir}/${name}.lock" lock_${name})
    string(STRIP "${lock_${name}}" lock_${name})
endforeach()

execute_process(COMMAND "${CMAKE_COMMAND}" "-DDVV_BUILD=${root}"
                        -P "${CMAKE_CURRENT_LIST_DIR}/ci-image-inputs.cmake"
                RESULT_VARIABLE status OUTPUT_VARIABLE inputs_out ERROR_VARIABLE inputs_err)
set(own_hash "")
if(status EQUAL 0 AND inputs_out MATCHES "^hash=([0-9a-f]+)")
    set(own_hash "${CMAKE_MATCH_1}")
endif()

# ---- check them ----
# 1. Inputs.
if(own_hash STREQUAL "")
    string(STRIP "${inputs_err}" inputs_err)
    problem("could not compute the inputs of ${root}: ${inputs_err}")
elseif(NOT image_inputs STREQUAL own_hash)
    problem("image built from inputs ${image_inputs}, this dvv-build has ${own_hash}")
endif()

# 2. User.
trimmed(uid "${uid_text}")
trimmed(gid "${gid_text}")
trimmed(owner "${owner_text}")
set(ids_ok TRUE)
foreach(id uid gid owner)
    if(NOT ${id} MATCHES "^[0-9]+$")
        set(ids_ok FALSE)
        if(NOT ${id}_text_failed) # the failed command is already reported
            problem("${id} '${${id}}' is not a number")
        endif()
    endif()
endforeach()
if(NOT ids_ok)
    # nothing to compare
elseif(uid STREQUAL "0")
    problem("running as root (uid 0); the job must run as the runner account")
elseif(NOT uid STREQUAL owner)
    problem("uid ${uid} is not the owner (${owner}) of GITHUB_WORKSPACE")
endif()

# 3. Tools.
file(STRINGS "${root}/tools/requirements.txt" req_lines)
foreach(line IN LISTS req_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
        continue()
    endif()
    if(line MATCHES "^([A-Za-z0-9_.-]+)==([0-9][0-9A-Za-z.+-]*)$")
        set(pin_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
    else()
        problem("tools/requirements.txt line '${line}' is not <name>==<version>")
        if(line MATCHES "^([A-Za-z0-9_.-]+)")
            set(malformed_${CMAKE_MATCH_1} TRUE) # its own message is enough
        endif()
    endif()
endforeach()

foreach(tool IN LISTS tools)
    if(NOT DEFINED pin_${tool})
        if(NOT malformed_${tool})
            problem("tools/requirements.txt has no pin for ${tool}")
        endif()
        continue()
    endif()
    set(pin "${pin_${tool}}")
    string(REGEX REPLACE "[.+]" "\\\\\\0" pin_re "${pin}")
    first_line(first "${version_${tool}}")
    set(entry_ok FALSE)
    if(tool STREQUAL "cmake")
        if(first STREQUAL "cmake version ${pin}")
            set(entry_ok TRUE)
        endif()
    elseif(tool STREQUAL "ninja")
        if(first MATCHES "^${pin_re}(\\.git\\..*)?$")
            set(entry_ok TRUE)
        endif()
    elseif(version_${tool} MATCHES "(^|[^0-9.])${pin_re}([^0-9.]|$)")
        set(entry_ok TRUE)
    endif()
    if(NOT entry_ok AND NOT version_${tool}_failed)
        version_of(found "${version_${tool}}")
        problem("${tool} ${found} installed, tools/requirements.txt pins ${pin}")
    endif()
    if(NOT pip_${tool} MATCHES "(^|\n)Version: ${pin_re}\r?(\n|$)")
        if(pip_${tool} MATCHES "(^|\n)Version: ([^\r\n]*)")
            set(found "${CMAKE_MATCH_2}")
        else()
            set(found "(not installed)")
        endif()
        problem("${tool} ${found} installed, tools/requirements.txt pins ${pin}")
    endif()
endforeach()

first_line(python_line "${python_text}")
if(NOT python_text_failed AND NOT python_line MATCHES "^Python 3\\.13\\.[0-9]+")
    string(REGEX REPLACE "^Python " "" python_found "${python_line}")
    problem("Python ${python_found} found, 3.13.x required")
endif()
trimmed(prefix "${prefix_text}")
foreach(var Python3_ROOT_DIR pythonLocation PKG_CONFIG_PATH)
    set(value "")
    if(env_text MATCHES "(^|\n)${var}=([^\r\n]*)")
        set(value "${CMAKE_MATCH_2}")
    endif()
    set(expected "${prefix}")
    if(var STREQUAL "PKG_CONFIG_PATH")
        set(expected "${prefix}/lib/pkgconfig")
    endif()
    if(NOT prefix_text_failed AND NOT value STREQUAL expected)
        problem("${var}=${value} is not the interpreter's install directory ${expected}")
    endif()
endforeach()

# 4. Compiler and packages.
if(clang_text MATCHES "clang version ([0-9]+)\\.")
    set(major "${CMAKE_MATCH_1}")
else()
    first_line(major "${clang_text}")
endif()
if(NOT clang_text_failed AND NOT major STREQUAL "19")
    problem("clang-19 reports major ${major}, 19 required")
endif()
foreach(pkg IN LISTS packages)
    trimmed(pkg_status "${dpkg_${pkg}}")
    if(NOT pkg_status STREQUAL "install ok installed")
        problem("package ${pkg} is not installed (${pkg_status})")
    endif()
endforeach()

get_property(failed GLOBAL PROPERTY DVV_CHECK_FAILED)
if(failed)
    return()
endif()

# 5. Report.
string(SUBSTRING "${image_inputs}" 0 16 inputs16)
string(SUBSTRING "${image_environment}" 0 16 env16)
set(report "::group::CI image\nuser ${uid}:${gid} (workspace owner ${owner})\n")
string(APPEND report "packages.lock:\n${lock_packages}\npip.lock:\n${lock_pip}\n")
string(APPEND report "inputs ${image_inputs}\nenvironment ${image_environment}\n")
if(NOT "$ENV{DVV_CI_IMAGE}" STREQUAL "")
    string(APPEND report "image $ENV{DVV_CI_IMAGE}\n")
endif()
string(APPEND report "::endgroup::\n")
string(APPEND report "check-ci-image: OK (inputs ${inputs16}, environment ${env16})")
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${report}")
