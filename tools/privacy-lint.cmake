# Privacy lint (spec §13.3): absolute machine paths, non-noreply e-mail addresses, IP addresses and
# caller-supplied terms (user and host name) in tracked files and commit metadata.
#
# Usage: cmake -DREPO=<repo dir> [-DMODE=tree|commits|prepush] [-DEXTRA_TERMS=<a;b>]
#              [-DPUSH_REFS=<local sha>:<remote sha>;...] -P tools/privacy-lint.cmake
#   tree     working-tree content of the tracked files (default)
#   commits  tree + metadata, messages and added lines of every commit reachable from HEAD
#   prepush  tree + the same for the commits being pushed: the ranges derived from PUSH_REFS
#            (deletions skipped, a new remote ref means "not on any remote", otherwise
#            <remote>..<local>), or HEAD --not --remotes without PUSH_REFS
# A repository without commits skips the commit checks; any other git failure is fatal.
# A line containing "privacy-lint: allow" is skipped. Findings report the location and kind only,
# never the matched text, so CI logs do not repeat private data.
cmake_minimum_required(VERSION 4.2)

if(NOT DEFINED REPO)
    message(FATAL_ERROR "privacy-lint: pass -DREPO=<repository directory>")
endif()
if(NOT DEFINED MODE)
    set(MODE tree)
endif()
if(NOT MODE MATCHES "^(tree|commits|prepush)$")
    message(FATAL_ERROR "privacy-lint: unknown MODE '${MODE}'")
endif()
find_program(GIT_EXECUTABLE git REQUIRED)
get_filename_component(REPO_ABSOLUTE "${REPO}" ABSOLUTE)
get_filename_component(REPO_NAME "${REPO_ABSOLUTE}" NAME)

# Placeholders keep ';', '[', ']' and '\' from breaking CMake list handling.
string(ASCII 1 PL_SEMI)
string(ASCII 2 PL_LBR)
string(ASCII 3 PL_RBR)
string(ASCII 4 PL_BSL)
string(ASCII 30 PL_RS)
string(ASCII 31 PL_US)

set(terms "")
foreach(term IN LISTS EXTRA_TERMS)
    string(STRIP "${term}" term)
    string(TOLOWER "${term}" term)
    string(LENGTH "${term}" length)
    if(length GREATER_EQUAL 3)
        list(APPEND terms "${term}")
    endif()
endforeach()

set_property(GLOBAL PROPERTY PL_FINDINGS 0)

function(_pl_escape text out)
    string(REPLACE "\\" "${PL_BSL}" text "${text}")
    string(REPLACE ";" "${PL_SEMI}" text "${text}")
    string(REPLACE "[" "${PL_LBR}" text "${text}")
    string(REPLACE "]" "${PL_RBR}" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(_pl_unescape text out)
    string(REPLACE "${PL_BSL}" "\\" text "${text}")
    string(REPLACE "${PL_SEMI}" ";" text "${text}")
    string(REPLACE "${PL_LBR}" "[" text "${text}")
    string(REPLACE "${PL_RBR}" "]" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(_pl_report where kind)
    message(STATUS "privacy-lint: ${where}: ${kind}")
    get_property(count GLOBAL PROPERTY PL_FINDINGS)
    math(EXPR count "${count} + 1")
    set_property(GLOBAL PROPERTY PL_FINDINGS ${count})
endfunction()

function(_pl_email_allowed email out)
    string(TOLOWER "${email}" email)
    # noreply@github.com is GitHub's own committer for web merges and CI's synthetic merge commits.
    if(email MATCHES "@users\\.noreply\\.github\\.com$"
       OR email STREQUAL "noreply@anthropic.com"
       OR email STREQUAL "noreply@github.com"
       OR email MATCHES "@example\\.(com|org|net)$")
        set(${out} 1 PARENT_SCOPE)
    else()
        set(${out} 0 PARENT_SCOPE)
    endif()
endfunction()

# Checks one unescaped line of text and reports every kind of finding once.
function(_pl_check_line where text)
    if(text MATCHES "privacy-lint: allow")
        return()
    endif()
    if(text MATCHES "[A-Za-z]:[\\/]+[Uu][Ss][Ee][Rr][Ss][\\/]+[A-Za-z0-9._-]")
        _pl_report("${where}" "Windows user profile path")
    elseif(text MATCHES "(^|[^A-Za-z0-9])[A-WYZa-wyz]:[\\/]+[A-Za-z0-9_]")
        _pl_report("${where}" "absolute drive path (use X: in examples)")
    endif()
    if(text MATCHES "/(home|Users)/[A-Za-z0-9._-]")
        _pl_report("${where}" "home directory path")
    endif()
    if(text MATCHES "/mnt/[A-Za-z]/[A-Za-z0-9._-]")
        _pl_report("${where}" "WSL mount path")
    endif()
    # SSH remotes such as git@host:org/repo.git are not e-mail addresses: drop only the
    # "git@host:" prefix and keep the path, so text glued to the remote is still checked.
    # The colon must be followed directly by a character that is not whitespace or a colon.
    string(REGEX REPLACE "(^|[^A-Za-z0-9._%+-])git@[A-Za-z0-9.-]+:([^ \t:])" "\\1 \\2"
           mail_text "${text}")
    string(REGEX MATCHALL "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z][A-Za-z]+" emails
           "${mail_text}")
    foreach(email IN LISTS emails)
        _pl_email_allowed("${email}" ok)
        if(NOT ok)
            _pl_report("${where}" "e-mail address that is not a noreply address")
            break()
        endif()
    endforeach()
    # Every maximal run of digits and dots is checked as a whole, so 1.2.3.4.5 and
    # version strings with a part above 255 are not addresses.
    string(REGEX MATCHALL "[0-9][0-9.]*" runs "${text}")
    foreach(run IN LISTS runs)
        string(REGEX REPLACE "\\.+$" "" run "${run}")
        if(NOT run MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
            continue()
        endif()
        set(octets "${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}" "${CMAKE_MATCH_3}" "${CMAKE_MATCH_4}")
        if(run STREQUAL "127.0.0.1" OR run STREQUAL "0.0.0.0")
            continue()
        endif()
        set(valid 1)
        foreach(octet IN LISTS octets)
            string(LENGTH "${octet}" octet_length)
            if(octet_length GREATER 3 OR octet GREATER 255)
                set(valid 0)
            endif()
        endforeach()
        if(valid)
            _pl_report("${where}" "IPv4 address")
            break()
        endif()
    endforeach()
    if(terms)
        string(TOLOWER "${text}" lower)
        foreach(term IN LISTS terms)
            string(FIND "${lower}" "${term}" position)
            if(position GREATER_EQUAL 0)
                _pl_report("${where}" "local user or host name")
                break()
            endif()
        endforeach()
    endif()
endfunction()

# Checks every line of a block of text; <prefix> is used as "<prefix>:<line>".
function(_pl_check_text prefix text)
    _pl_escape("${text}" escaped)
    string(REPLACE "\r" "" escaped "${escaped}")
    string(REPLACE "\n" ";" lines "${escaped}")
    set(number 0)
    foreach(line IN LISTS lines)
        math(EXPR number "${number} + 1")
        _pl_unescape("${line}" plain)
        _pl_check_line("${prefix}:${number}" "${plain}")
    endforeach()
endfunction()

# 1. Tracked files.
execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" -c core.quotepath=off ls-files
    OUTPUT_VARIABLE listing ERROR_QUIET RESULT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "privacy-lint: '${REPO_NAME}' is not a git repository")
endif()
string(REPLACE "\n" ";" files "${listing}")
foreach(file IN LISTS files)
    set(path "${REPO}/${file}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        continue()
    endif()
    _pl_check_line("path ${file}" "${file}")
    file(READ "${path}" head LIMIT 4096 HEX)
    if(head MATCHES "^(..)*00")
        continue()  # binary file
    endif()
    file(READ "${path}" content)
    _pl_check_text("${file}" "${content}")
endforeach()


# 2. Commit metadata, messages and added lines.
function(_pl_git_log out)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" -c core.quotepath=off log ${ARGN}
        OUTPUT_VARIABLE log ERROR_QUIET RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        # git's stderr is not printed: it can contain absolute paths.
        message(FATAL_ERROR "privacy-lint: git log failed for a pushed range or history "
                            "in '${REPO_NAME}'")
    endif()
    set(${out} "${log}" PARENT_SCOPE)
endfunction()

# Metadata and message of every commit selected by the revision arguments.
function(_pl_check_commit_metadata)
    _pl_git_log(log ${ARGN} "--format=%h%x1f%an%x1f%ae%x1f%cn%x1f%ce%x1f%B%x1e")
    _pl_escape("${log}" log)
    string(REPLACE "${PL_RS}" ";" records "${log}")
    foreach(record IN LISTS records)
        string(STRIP "${record}" record)
        if(record STREQUAL "")
            continue()
        endif()
        string(REPLACE "${PL_US}" ";" fields "${record}")
        list(GET fields 0 hash)
        list(GET fields 1 author)
        list(GET fields 2 author_email)
        list(GET fields 3 committer)
        list(GET fields 4 committer_email)
        list(GET fields 5 body)
        foreach(role IN ITEMS author committer)
            _pl_unescape("${${role}_email}" email)
            _pl_email_allowed("${email}" ok)
            # GitHub's own address is a committer (web and PR merges), never an author.
            string(TOLOWER "${email}" email)
            if(role STREQUAL "author" AND email STREQUAL "noreply@github.com")
                set(ok 0)
            endif()
            if(NOT ok)
                _pl_report("commit ${hash}" "author or committer e-mail is not a noreply address")
            endif()
        endforeach()
        _pl_unescape("${author} ${committer}" names)
        _pl_check_line("commit ${hash} names" "${names}")
        _pl_unescape("${body}" body)
        _pl_check_text("commit ${hash} message" "${body}")
    endforeach()
endfunction()

# Added lines of every commit's patch, reported as "commit <hash> <file>:<line>".
function(_pl_check_commit_patches)
    _pl_git_log(log ${ARGN} --no-color --no-ext-diff --no-textconv -p --unified=0
                --src-prefix=a/ --dst-prefix=b/ "--format=%x1e%h")
    _pl_escape("${log}" log)
    string(REPLACE "\r" "" log "${log}")
    string(REPLACE "${PL_RS}" ";" records "${log}")
    foreach(record IN LISTS records)
        if(record STREQUAL "")
            continue()
        endif()
        string(REPLACE "\n" ";" lines "${record}")
        list(POP_FRONT lines hash)
        set(file "")
        set(number 0)
        set(in_hunk 0)
        foreach(line IN LISTS lines)
            if(line MATCHES "^diff --git ")
                set(file "")
                set(in_hunk 0)
            elseif(in_hunk AND line MATCHES "^\\+")
                string(SUBSTRING "${line}" 1 -1 added)
                _pl_unescape("${added}" added)
                _pl_check_line("commit ${hash} ${file}:${number}" "${added}")
                math(EXPR number "${number} + 1")
            elseif(in_hunk AND line MATCHES "^-")
                continue()
            elseif(line MATCHES "^@@ -[0-9,]+ \\+([0-9]+)")
                set(number "${CMAKE_MATCH_1}")
                set(in_hunk 1)
            elseif(NOT in_hunk AND line MATCHES "^\\+\\+\\+ b/(.*)$")
                string(REGEX REPLACE "\t.*$" "" file "${CMAKE_MATCH_1}")
                _pl_unescape("${file}" file)
            endif()
        endforeach()
    endforeach()
endfunction()

function(_pl_check_commits)
    _pl_check_commit_metadata(${ARGN})
    _pl_check_commit_patches(${ARGN})
endfunction()

if(NOT MODE STREQUAL "tree")
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" rev-parse --verify -q HEAD
        OUTPUT_QUIET ERROR_VARIABLE git_error RESULT_VARIABLE status)
    if(status EQUAL 0)
        set(has_commits 1)
    elseif(git_error STREQUAL "")
        set(has_commits 0)  # no commits yet: nothing to check
    else()
        message(FATAL_ERROR "privacy-lint: git rev-parse failed in '${REPO_NAME}'")
    endif()
    if(NOT has_commits)
        message(STATUS "privacy-lint: no commits yet, commit checks skipped")
    elseif(MODE STREQUAL "commits")
        _pl_check_commits(HEAD)
    elseif(NOT DEFINED PUSH_REFS)
        _pl_check_commits(HEAD --not --remotes)
    else()
        foreach(ref IN LISTS PUSH_REFS)
            if(NOT ref MATCHES "^([0-9a-fA-F]+):([0-9a-fA-F]+)$")
                message(FATAL_ERROR "privacy-lint: bad PUSH_REFS entry (want <local>:<remote>)")
            endif()
            set(local_sha "${CMAKE_MATCH_1}")
            set(remote_sha "${CMAKE_MATCH_2}")
            if(local_sha MATCHES "^0+$")
                continue()  # deletion
            elseif(remote_sha MATCHES "^0+$")
                _pl_check_commits(${local_sha} --not --remotes)
            else()
                _pl_check_commits(${remote_sha}..${local_sha})
            endif()
        endforeach()
    endif()
endif()

get_property(count GLOBAL PROPERTY PL_FINDINGS)
if(count GREATER 0)
    message(FATAL_ERROR "privacy-lint: ${count} finding(s) in repository '${REPO_NAME}'")
endif()
message(STATUS "privacy-lint: clean (${MODE})")
