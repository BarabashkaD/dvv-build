# os-blocks.cmake: the per-OS code gate. Counts the OS #if blocks of a repository's shared sources
# against a baseline that may only shrink. Part of dvv-build.
# Usage: cmake -DREPO=<repository folder> [-DMODE=check|write] [-DBASELINE=<file>] -P <dvv-build>/tools/os-blocks.cmake
# REPO must be the top of a git work tree. MODE defaults to check; BASELINE to <REPO>/os-blocks.txt.
# Files: the tracked *.h, *.cpp and *.mm files, except those under tests/ and the per-OS files
#   (stem ending in _<suffix> for a suffix of dvv_os_all_suffixes, cmake/DvvOsSources.cmake).
# OS group: an #if/#ifdef/#ifndef group whose condition, or that of one of its #elif* lines, names
#   _WIN32, __APPLE__, __linux__, TARGET_OS_*, __WXMSW__, __WXOSX__* or __WXGTK__.
# Counted block: an OS group with no OS ancestor, from its #if line to its #endif line, that spans
#   more than 5 lines and holds a code line. Free lines (not code): blank lines, comments, the
#   conditional directives, #include, #pragma, #error and #warning. #define and #undef are code.
# Baseline: a header line, then one "<count><TAB><path>" row per file with counted blocks, sorted by
#   path. A missing file is an empty baseline.
# check: a bad baseline line fails at once; then every count above its row, count below its row
#   and stale row (a path that is no longer counted) is reported, and the script fails if there is
#   any. write: rewrites the baseline from the tree; with zero rows it deletes the file.
cmake_minimum_required(VERSION 4.2)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/DvvOsSources.cmake")
find_program(GIT_EXECUTABLE git REQUIRED)
set(header "# os-blocks baseline, written by dvv-build tools/os-blocks.cmake; it may only shrink")

if(NOT DEFINED REPO OR REPO STREQUAL "")
    message(FATAL_ERROR "pass -DREPO=<repository folder>")
endif()
if(NOT DEFINED MODE OR MODE STREQUAL "")
    set(MODE check)
elseif(NOT MODE MATCHES "^(check|write)$")
    message(FATAL_ERROR "MODE must be check or write (default: check), got '${MODE}'")
endif()

# REPO is the top of a git work tree (a plain folder inside another work tree, or a subfolder of a
# repository, would list the wrong files or none).
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" rev-parse --show-toplevel
                RESULT_VARIABLE rc OUTPUT_VARIABLE top ERROR_QUIET
                OUTPUT_STRIP_TRAILING_WHITESPACE ENCODING UTF-8)
set(repo "")
if(rc EQUAL 0 AND NOT top STREQUAL "")
    file(REAL_PATH "${REPO}" repo)
    file(REAL_PATH "${top}" top)
endif()
if(NOT rc EQUAL 0 OR repo STREQUAL "" OR NOT repo STREQUAL top)
    message(FATAL_ERROR "${REPO} is not the top of a git work tree")
endif()
if(NOT DEFINED BASELINE OR BASELINE STREQUAL "")
    set(BASELINE "${repo}/os-blocks.txt")
endif()

# Text is split into CMake lists line by line. The characters that a list element cannot hold
# verbatim (; \ [ ]) are replaced by control characters first and restored for output.
string(ASCII 1 PH_SEMI)
string(ASCII 2 PH_BSL)
string(ASCII 3 PH_LBR)
string(ASCII 4 PH_RBR)
# encode_lines(<text> <out-var>): the lines of <text> as a list; \r before \n dropped; every line,
# empty ones included, keeps its 1-based position. A final newline adds no line.
function(encode_lines text out)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(REPLACE "\\" "${PH_BSL}" text "${text}")
    string(REPLACE ";" "${PH_SEMI}" text "${text}")
    string(REPLACE "[" "${PH_LBR}" text "${text}")
    string(REPLACE "]" "${PH_RBR}" text "${text}")
    string(REGEX REPLACE "\n$" "" text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()
# decode(<var>): restores the replaced characters in the variable <var>.
function(decode var)
    set(text "${${var}}")
    string(REPLACE "${PH_SEMI}" ";" text "${text}")
    string(REPLACE "${PH_BSL}" "\\" text "${text}")
    string(REPLACE "${PH_LBR}" "[" text "${text}")
    string(REPLACE "${PH_RBR}" "]" text "${text}")
    set(${var} "${text}" PARENT_SCOPE)
endfunction()

# Baseline: rows_paths and rows_counts, in file order. A bad line fails at once.
set(rows_paths "")
set(rows_counts "")
if(EXISTS "${BASELINE}")
    file(READ "${BASELINE}" text)
    encode_lines("${text}" lines)
    set(n 0)
    foreach(line IN LISTS lines)
        math(EXPR n "${n} + 1")
        if(n EQUAL 1 AND line MATCHES "^#")
            continue()
        endif()
        if(NOT line MATCHES "^([^\t]*)\t([^\t]+)$")
            message(FATAL_ERROR "bad baseline line ${n}: not <count><TAB><path>")
        endif()
        set(count "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        if(NOT count MATCHES "^[1-9][0-9]*$")
            message(FATAL_ERROR "bad baseline line ${n}: the count '${count}' is not a positive decimal integer")
        endif()
        list(FIND rows_paths "${path}" seen)
        if(NOT seen EQUAL -1)
            decode(path)
            message(FATAL_ERROR "bad baseline line ${n}: ${path} appears twice")
        endif()
        list(APPEND rows_paths "${path}")
        list(APPEND rows_counts "${count}")
    endforeach()
endif()

list(LENGTH rows_paths n_baseline)

# Files.
execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.quotePath=false -C "${repo}" ls-files
                        -- "*.h" "*.cpp" "*.mm"
                RESULT_VARIABLE rc OUTPUT_VARIABLE listed ERROR_VARIABLE err ENCODING UTF-8)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "git ls-files failed in ${repo}:\n${err}")
endif()
dvv_os_all_suffixes(suffixes)
list(JOIN suffixes "|" suffix_alt)
encode_lines("${listed}" listed)
set(files "")
foreach(path IN LISTS listed)
    if(path STREQUAL "" OR path MATCHES "^tests/")
        continue()
    endif()
    set(display "${path}")
    decode(display)
    if(path MATCHES "^\"")
        message(FATAL_ERROR "os-blocks: git quoted the path ${display}; rename it")
    endif()
    if(NOT EXISTS "${repo}/${display}")
        continue()    # deleted in the work tree, not yet in the index
    endif()
    get_filename_component(stem "${path}" NAME_WLE)
    if(NOT stem MATCHES "_(${suffix_alt})$")
        list(APPEND files "${path}")
    endif()
endforeach()

set(os_ids "_WIN32|__APPLE__|__linux__|__WXMSW__|__WXGTK__|TARGET_OS_[A-Za-z0-9_]*|__WXOSX__[A-Za-z0-9_]*")
set(os_regex "[^A-Za-z0-9_](${os_ids})[^A-Za-z0-9_]")
set(free_directives "^(if|ifdef|ifndef|elif|elifdef|elifndef|else|endif|include|pragma|error|warning)$")

# strip_comments(<line>): sets `code` to the line without its comments (each replaced by a space)
# and updates `in_comment` (inside a /* */ comment) and `raw_end` (inside a raw string literal,
# whose closing sequence it holds) in the caller. "..." and '...' literals and raw string literals
# (any prefix, any delimiter, across lines) are skipped: their content is code text.
macro(strip_comments line)
    set(code "")
    set(rest "${line}")
    while(NOT rest STREQUAL "")
        if(in_comment)
            string(FIND "${rest}" "*/" pos)
            if(pos EQUAL -1)
                set(rest "")
            else()
                math(EXPR pos "${pos} + 2")
                string(SUBSTRING "${rest}" ${pos} -1 rest)
                string(APPEND code " ")
                set(in_comment FALSE)
            endif()
            continue()
        endif()
        if(NOT raw_end STREQUAL "")
            string(FIND "${rest}" "${raw_end}" pos)
            if(pos EQUAL -1)
                string(APPEND code "${rest}")
                set(rest "")
            else()
                string(LENGTH "${raw_end}" len)
                math(EXPR pos "${pos} + ${len}")
                string(SUBSTRING "${rest}" 0 ${pos} literal)
                string(APPEND code "${literal}")
                string(SUBSTRING "${rest}" ${pos} -1 rest)
                set(raw_end "")
            endif()
            continue()
        endif()
        string(REGEX MATCH "^[^\"'/]*" plain "${rest}")
        string(LENGTH "${plain}" pos)
        string(APPEND code "${plain}")
        string(SUBSTRING "${rest}" ${pos} -1 rest)
        if(rest MATCHES "^/\\*")
            set(in_comment TRUE)
            string(SUBSTRING "${rest}" 2 -1 rest)
            string(APPEND code " ")
        elseif(rest MATCHES "^//")
            set(rest "")
        elseif(rest MATCHES "^/")
            string(APPEND code "/")
            string(SUBSTRING "${rest}" 1 -1 rest)
        elseif(" ${code}" MATCHES "[^A-Za-z0-9_](u8|u|U|L)?R$"
               AND rest MATCHES "^\"([^ ()\t${PH_BSL}]*)\\(")
            # A raw string literal: R"delim( ... )delim".
            set(raw_end ")${CMAKE_MATCH_1}\"")
            string(LENGTH "${CMAKE_MATCH_0}" pos)
            string(SUBSTRING "${rest}" 0 ${pos} literal)
            string(APPEND code "${literal}")
            string(SUBSTRING "${rest}" ${pos} -1 rest)
        elseif(rest MATCHES "^\"([^\"${PH_BSL}]|${PH_BSL}.)*(\"|$)")
            string(APPEND code "${CMAKE_MATCH_0}")
            string(LENGTH "${CMAKE_MATCH_0}" pos)
            string(SUBSTRING "${rest}" ${pos} -1 rest)
        elseif(rest MATCHES "^'([^'${PH_BSL}]|${PH_BSL}.[^']*)'")
            string(APPEND code "${CMAKE_MATCH_0}")
            string(LENGTH "${CMAKE_MATCH_0}" pos)
            string(SUBSTRING "${rest}" ${pos} -1 rest)
        elseif(rest MATCHES "^'")
            # A lone quote, for example a digit separator (1'000).
            string(APPEND code "'")
            string(SUBSTRING "${rest}" 1 -1 rest)
        else()
            string(APPEND code "${rest}")
            set(rest "")
        endif()
    endwhile()
endmacro()

# count_blocks(<path>): sets `blocks` to the file's counted blocks, or `unbalanced` to the line of
# an #endif without #if or of an #if without #endif.
function(count_blocks path)
    file(READ "${repo}/${path}" text)
    encode_lines("${text}" lines)
    set(in_comment FALSE)
    set(raw_end "")         # the closing sequence of the raw string literal being read
    set(continued FALSE)    # the previous line was a directive ending in a backslash
    set(directive "")       # keyword of the directive being read
    set(condition "")
    # The open groups, innermost last: first line, OS flag, holds-a-code-line flag.
    set(open_starts "")
    set(open_os "")
    set(open_code "")
    set(depth 0)
    set(counted "")         # first lines of the outermost OS groups found so far that count
    set(n 0)
    foreach(line IN LISTS lines)
        math(EXPR n "${n} + 1")
        set(in_raw_string FALSE)
        if(NOT raw_end STREQUAL "")
            set(in_raw_string TRUE)
        endif()
        if(in_comment OR in_raw_string OR line MATCHES "[\"'/]")
            strip_comments("${line}")
        else()
            set(code "${line}")
        endif()
        if(continued)
            string(APPEND condition " ${code}")
            if(NOT line MATCHES "${PH_BSL}$")
                set(continued FALSE)
            endif()
        elseif(in_raw_string)
            # The line begins inside a raw string literal: code text, never a directive.
            if(depth GREATER 0)
                list(POP_BACK open_code)
                list(APPEND open_code 1)
            endif()
            continue()
        elseif(code MATCHES "^[ \t]*$")
            continue()
        elseif(code MATCHES "^[ \t]*#[ \t]*([A-Za-z_]*)(.*)$")
            set(directive "${CMAKE_MATCH_1}")
            set(condition "${CMAKE_MATCH_2}")
            set(directive_line ${n})
            if(line MATCHES "${PH_BSL}$")
                set(continued TRUE)
            endif()
            if(NOT directive MATCHES "${free_directives}" AND depth GREATER 0)
                list(POP_BACK open_code)
                list(APPEND open_code 1)
            endif()
        else()
            if(depth GREATER 0)
                list(POP_BACK open_code)
                list(APPEND open_code 1)
            endif()
            continue()
        endif()
        if(continued)
            continue()
        endif()
        # A complete directive: update the group tree.
        set(os 0)
        if(" ${condition} " MATCHES "${os_regex}")
            set(os 1)
        endif()
        if(directive MATCHES "^(if|ifdef|ifndef)$")
            list(APPEND open_starts ${directive_line})
            list(APPEND open_os ${os})
            list(APPEND open_code 0)
            math(EXPR depth "${depth} + 1")
        elseif(directive MATCHES "^(elif|elifdef|elifndef|else|endif)$")
            if(depth EQUAL 0)
                set(unbalanced ${directive_line} PARENT_SCOPE)
                return()
            endif()
            if(directive MATCHES "^elif" AND os)
                list(POP_BACK open_os)
                list(APPEND open_os 1)
            elseif(directive STREQUAL "endif")
                list(POP_BACK open_starts start)
                list(POP_BACK open_os group_os)
                list(POP_BACK open_code group_code)
                math(EXPR depth "${depth} - 1")
                if(group_code AND depth GREATER 0)
                    list(POP_BACK open_code)
                    list(APPEND open_code 1)
                endif()
                if(group_os)
                    # OS groups closed inside this one are part of it.
                    set(outer "")
                    foreach(first IN LISTS counted)
                        if(first LESS start)
                            list(APPEND outer ${first})
                        endif()
                    endforeach()
                    set(counted "${outer}")
                    math(EXPR span "${directive_line} - ${start} + 1")
                    if(span GREATER 5 AND group_code)
                        list(APPEND counted ${start})
                    endif()
                endif()
            endif()
        endif()
    endforeach()
    if(depth GREATER 0)
        list(GET open_starts 0 first)
        set(unbalanced ${first} PARENT_SCOPE)
        return()
    endif()
    list(LENGTH counted blocks)
    set(blocks ${blocks} PARENT_SCOPE)
endfunction()

set(problems "")
set(unbalanced_files "")
set(total 0)
set(new_rows "")
set(n_rows 0)
foreach(path IN LISTS files)
    set(display "${path}")
    decode(display)
    unset(unbalanced)
    set(blocks 0)
    count_blocks("${display}")
    list(FIND rows_paths "${path}" row)
    if(DEFINED unbalanced)
        string(APPEND unbalanced_files "${display}: unbalanced #if/#endif at line ${unbalanced}\n")
        if(NOT row EQUAL -1)
            list(REMOVE_AT rows_paths ${row})
            list(REMOVE_AT rows_counts ${row})
        endif()
        continue()
    endif()
    math(EXPR total "${total} + ${blocks}")
    if(blocks GREATER 0)
        string(APPEND new_rows "${blocks}\t${display}\n")
        math(EXPR n_rows "${n_rows} + 1")
    endif()
    set(base 0)
    if(NOT row EQUAL -1)
        list(GET rows_counts ${row} base)
        list(REMOVE_AT rows_paths ${row})
        list(REMOVE_AT rows_counts ${row})
    endif()
    if(blocks GREATER base)
        string(APPEND problems "${display}: ${blocks} OS blocks over 5 lines (baseline ${base}): move the code into a per-OS file\n")
    elseif(blocks LESS base)
        string(APPEND problems "${display}: ${blocks} blocks, baseline ${base}: shrink the baseline (MODE=write)\n")
    endif()
endforeach()
list(LENGTH files n_files)

if(MODE STREQUAL "write")
    if(NOT unbalanced_files STREQUAL "")
        message(FATAL_ERROR "os-blocks: baseline not written:\n${unbalanced_files}")
    endif()
    if(n_rows EQUAL 0)
        file(REMOVE "${BASELINE}")
        message(STATUS "os-blocks: no counted blocks, ${BASELINE} removed (${n_files} files)")
    else()
        file(WRITE "${BASELINE}" "${header}\n${new_rows}")
        message(STATUS "os-blocks: wrote ${BASELINE} (${n_files} files, ${total} counted blocks, ${n_rows} rows)")
    endif()
    return()
endif()

foreach(path IN LISTS rows_paths)
    decode(path)
    string(APPEND problems "stale row ${path}\n")
endforeach()
string(PREPEND problems "${unbalanced_files}")
if(NOT problems STREQUAL "")
    message(FATAL_ERROR "os-blocks:\n${problems}")
endif()
message(STATUS "os-blocks: OK (${n_files} files, ${total} counted blocks, baseline ${n_baseline} rows)")
